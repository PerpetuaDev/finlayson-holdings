---
import Base from '../../layouts/Base.astro';
import Band from '../Band.astro';
import copyEn from '../../data/copy/en/privacy.json';
import copyJa from '../../data/copy/ja/privacy.json';

interface Props {
  locale: 'en' | 'ja';
}

const { locale } = Astro.props;
const t = { en: copyEn, ja: copyJa }[locale];
const title =
  locale === 'ja' ? 'プライバシー — Finlayson Holdings' : 'Privacy — Finlayson Holdings';
---

<Base locale={locale} slug="privacy" title={title} description={t.masthead.lede}>
  <section class="masthead">
    <p class="masthead__label">{t.masthead.label}</p>
    <h1>{t.masthead.h1}</h1>
    <p class="masthead__lede">{t.masthead.lede}</p>
    <p class="effective">{t.effective}</p>
  </section>

  <Band label={t.policyLabel} padded={false}>
    {
      t.sections.map((s) => (
        <div class="def-row">
          <div class="def-row__term">{s.term}</div>
          <p class="def-row__body">{s.body}</p>
        </div>
      ))
    }
  </Band>
</Base>

<style>
  .effective {
    margin-top: 26px;
    font-size: 12.5px;
    letter-spacing: 0.08em;
    color: var(--ink-45);
  }

  .effective:lang(ja) {
    letter-spacing: 0.14em;
  }
</style>
