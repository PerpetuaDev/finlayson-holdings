---
import Base from '../../layouts/Base.astro';
import copyEn from '../../data/copy/en/news.json';
import copyJa from '../../data/copy/ja/news.json';

interface Props {
  locale: 'en' | 'ja';
}

const { locale } = Astro.props;
const t = { en: copyEn, ja: copyJa }[locale];
const title = locale === 'ja' ? 'お知らせ — Finlayson Holdings' : 'News — Finlayson Holdings';
---

<Base locale={locale} slug="news" title={title}>
  <section class="masthead">
    <p class="masthead__label">{t.masthead.label}</p>
    <h1>{t.masthead.h1}</h1>
  </section>

  <section class="band">
    <div class="band__rail"><span class="band__label band__label--num">{t.yearRail}</span></div>
    <div class="band__content band__content--flush">
      {
        t.entries.map((entry) => (
          <div class="entry">
            <span class="date">{entry.date}</span>
            <span class="chip">{entry.category}</span>
            <span class="title">{entry.title}</span>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .entry {
    display: grid;
    grid-template-columns: 160px 140px 1fr;
    gap: 24px;
    align-items: baseline;
    padding: 34px var(--side);
    border-bottom: var(--hairline-inner);
  }

  .entry:lang(ja) {
    grid-template-columns: 160px 120px 1fr;
  }

  .date {
    font-size: 13.5px;
    color: var(--ink-50);
    font-family: var(--font-latin);
  }

  .chip {
    font-size: 10.5px;
    letter-spacing: 0.14em;
    color: var(--vermilion);
    font-weight: 600;
    text-transform: uppercase;
  }

  .chip:lang(ja) {
    font-size: 11px;
    letter-spacing: 0.2em;
  }

  .title {
    font-size: 15.5px;
  }

  .title:lang(ja) {
    font-size: 15px;
  }

  @media (max-width: 900px) {
    .entry,
    .entry:lang(ja) {
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 24px var(--side);
    }
  }
</style>
