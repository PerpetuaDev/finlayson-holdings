---
import Base from '../../layouts/Base.astro';
import Band from '../Band.astro';
import copyEn from '../../data/copy/en/partners.json';
import copyJa from '../../data/copy/ja/partners.json';
import { localePath } from '../../lib/paths';

interface Props {
  locale: 'en' | 'ja';
}

const { locale } = Astro.props;
const t = { en: copyEn, ja: copyJa }[locale];
const title =
  locale === 'ja'
    ? '資本・パートナー — Finlayson Holdings'
    : 'Capital & Partners — Finlayson Holdings';
---

<Base locale={locale} slug="partners" title={title} description={t.masthead.lede}>
  <section class="masthead">
    <p class="masthead__label">{t.masthead.label}</p>
    <h1>{t.masthead.h1}</h1>
    <p class="masthead__lede">{t.masthead.lede}</p>
  </section>

  <Band label={t.brief.label} padded={false}>
    {
      t.brief.rows.map((row) => (
        <div class="def-row">
          <div class="def-row__term">{row.term}</div>
          <p class="def-row__body">{row.body}</p>
        </div>
      ))
    }
  </Band>

  <Band label={t.note.label} warm>
    <p class="note-body">{t.note.body}</p>
    <a class="btn-ink" href={localePath(locale, t.note.cta.path)}>{t.note.cta.label}</a>
  </Band>
</Base>

<style>
  .note-body {
    font-size: 16px;
    line-height: 1.75;
    color: var(--ink-75);
    max-width: 620px;
    margin: 0 0 30px;
  }

  .note-body:lang(ja) {
    font-size: 15px;
    line-height: 2.1;
  }
</style>
