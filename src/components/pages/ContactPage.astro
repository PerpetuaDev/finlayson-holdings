---
import Base from '../../layouts/Base.astro';
import copyEn from '../../data/copy/en/contact.json';
import copyJa from '../../data/copy/ja/contact.json';
import { site } from '../../data/site';

interface Props {
  locale: 'en' | 'ja';
}

const { locale } = Astro.props;
const t = { en: copyEn, ja: copyJa }[locale];
const states = t.form.states;
const title =
  locale === 'ja' ? 'お問い合わせ — Finlayson Holdings' : 'Contact — Finlayson Holdings';
---

<Base locale={locale} slug="contact" title={title} description={t.masthead.lede}>
  <section class="masthead">
    <p class="masthead__label">{t.masthead.label}</p>
    <h1>{t.masthead.h1}</h1>
    <p class="masthead__lede">{t.masthead.lede}</p>
  </section>

  <section class="band">
    <div class="band__rail"><span class="band__label">{t.note.label}</span></div>
    <div class="note">
      <div class="accent-square"></div>
      <p>
        {t.note.before}<a href={t.note.mdmcLink.url} target="_blank" rel="noopener">{t.note.mdmcLink.label}</a>{t.note.between}<a href={t.note.perpetuaLink.url} target="_blank" rel="noopener">{t.note.perpetuaLink.label}</a>{t.note.after}
      </p>
    </div>
  </section>

  <section class="band">
    <div class="band__rail"><span class="band__label">{t.form.label}</span></div>
    <div class="inquiry">
      <form class="form" id="inquiry-form">
        <div class="field">
          <label for="inquiry-type">{t.form.type.label}</label>
          <select id="inquiry-type" name="type">
            {t.form.type.options.map((o) => <option value={o}>{o}</option>)}
          </select>
        </div>
        <div class="two-up">
          <div class="field">
            <label for="inquiry-name">{t.form.name.label}</label>
            <input
              id="inquiry-name"
              name="name"
              type="text"
              placeholder={t.form.name.placeholder}
              required
            />
          </div>
          <div class="field">
            <label for="inquiry-company">{t.form.company.label}</label>
            <input
              id="inquiry-company"
              name="company"
              type="text"
              placeholder={t.form.company.placeholder}
            />
          </div>
        </div>
        <div class="field">
          <label for="inquiry-email">{t.form.email.label}</label>
          <input
            id="inquiry-email"
            name="email"
            type="email"
            placeholder={t.form.email.placeholder}
            required
          />
        </div>
        <div class="field">
          <label for="inquiry-message">{t.form.message.label}</label>
          <textarea
            id="inquiry-message"
            name="message"
            rows="6"
            placeholder={t.form.message.placeholder}
            required></textarea>
        </div>
        {/* honeypot — bots fill it, people never see it */}
        <div class="hp" aria-hidden="true">
          <label for="inquiry-website">Website</label>
          <input id="inquiry-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        {
          site.turnstileSiteKey && (
            <div
              class="cf-turnstile"
              data-sitekey={site.turnstileSiteKey}
              data-theme="light"
              data-language={locale}
              data-appearance="interaction-only"
              data-action="turnstile-spin-v2"
            />
          )
        }
        <div>
          <button class="btn-ink btn-ink--submit" type="submit">{t.form.submit}</button>
          {t.form.privacyNote && <p class="privacy">{t.form.privacyNote}</p>}
          <p class="form-error" id="inquiry-error" hidden>{states.error}</p>
        </div>
      </form>
      <p class="form-success" id="inquiry-success" hidden>{states.success}</p>
      <div class="address">
        <p class="address__heading">{t.address.heading}</p>
        {t.address.lines.map((line) => <p>{line}</p>)}
        <div class="attention">
          {t.address.attention.map((line) => <p>{line}</p>)}
        </div>
      </div>
    </div>
  </section>
</Base>

{
  site.turnstileSiteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
  )
}

<script
  is:inline
  define:vars={{ endpoint: site.contactEndpoint, sendingLabel: states.sending, locale }}
>
  (function () {
    var form = document.getElementById('inquiry-form');
    if (!form) return;
    var button = form.querySelector('button[type="submit"]');
    var idleLabel = button.textContent;
    var errorEl = document.getElementById('inquiry-error');
    var successEl = document.getElementById('inquiry-success');

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      errorEl.hidden = true;
      button.disabled = true;
      button.textContent = sendingLabel;
      try {
        var data = new FormData(form);
        var res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            type: data.get('type'),
            name: data.get('name'),
            company: data.get('company'),
            email: data.get('email'),
            message: data.get('message'),
            website: data.get('website'),
            turnstile: data.get('cf-turnstile-response'),
            lang: locale,
          }),
        });
        var out = await res.json();
        if (!res.ok || !out.ok) throw new Error('send failed');
        form.hidden = true;
        successEl.hidden = false;
      } catch (err) {
        errorEl.hidden = false;
        button.disabled = false;
        button.textContent = idleLabel;
        // Turnstile tokens are single-use — issue a fresh one for the retry
        if (window.turnstile) window.turnstile.reset();
      }
    });
  })();
</script>

<style>
  .note {
    border-left: var(--hairline);
    padding: 44px var(--side);
    display: flex;
    gap: 28px;
    align-items: baseline;
  }

  .note .accent-square {
    flex: none;
    transform: translateY(-1px);
  }

  .note p {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--ink-66);
    max-width: 640px;
  }

  .note p:lang(ja) {
    font-size: 14px;
    line-height: 2;
  }

  .note a {
    border-bottom: 1px solid var(--ink-40);
  }

  .inquiry {
    border-left: var(--hairline);
    padding: 64px var(--side) 72px;
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 64px;
    align-items: start;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 560px;
  }

  .two-up {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .field label {
    display: block;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--ink-55);
    margin-bottom: 7px;
    text-transform: uppercase;
  }

  .field label:lang(ja) {
    letter-spacing: 0.14em;
  }

  .btn-ink--submit {
    padding: 13px 26px;
  }

  .btn-ink--submit:disabled {
    background: var(--ink-55);
    cursor: default;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-error {
    margin-top: 14px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--vermilion);
    max-width: 420px;
  }

  .form-success {
    font-size: 15px;
    line-height: 1.8;
    color: var(--ink-75);
    max-width: 480px;
    border-top: 2px solid var(--vermilion);
    padding-top: 22px;
  }

  .form-success:lang(ja) {
    line-height: 2.1;
  }

  .privacy {
    margin: 4px 0 0;
    font-size: 12px;
    line-height: 1.9;
    color: var(--ink-50);
  }

  .address {
    font-size: 13px;
    line-height: 2;
    color: var(--ink-60);
    border-top: var(--hairline-inner);
    padding-top: 22px;
  }

  .address:lang(ja) {
    line-height: 2.1;
  }

  .address__heading {
    color: var(--ink);
    font-weight: 600;
    margin-bottom: 6px;
  }

  .attention {
    margin-top: 22px;
    color: var(--ink-50);
  }

  @media (max-width: 900px) {
    .note,
    .inquiry {
      border-left: none;
    }

    .inquiry {
      grid-template-columns: 1fr;
      gap: 48px;
      padding: 40px var(--side) 56px;
    }

    .two-up {
      grid-template-columns: 1fr;
    }
  }
</style>
